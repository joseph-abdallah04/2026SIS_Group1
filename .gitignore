# Dependencies
node_modules/

# Builds
dist/
build/
*.tsbuildinfo

# Env files
.env
.env.local
.env.*.local

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Test artifacts
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*

# Stray emit inside the shared package's source. A `tsc` run without `outDir`
# drops compiled `.js` next to the `.ts`, which is worse than untidy: those
# files satisfy the `./x.js` specifiers the sources use, so a build that would
# fail in production starts working locally and hides the problem.
packages/shared/src/*.js
packages/shared/src/*.js.map
packages/shared/src/*.d.ts
