PORT=3001
# JWT_SECRET is required (env.ts fails to boot without it) — this is a shared
# local-dev-only placeholder, not a real secret. Everyone's existing local
# .env still has JWT_SECRET= (empty) from before this was required; refill it
# with this value (or your own 32+ char string) or the server won't start.
JWT_SECRET=dev-only-placeholder-not-a-real-secret-32chars
# Local dev: run `npm run db:up` (Docker Postgres), then use this value as-is.
# Production (Render): set to Neon's *pooled* connection string (host contains "-pooler"),
# in Render's env vars only — never put Neon's URL in a local .env.
DATABASE_URL=postgresql://roundtable:roundtable@localhost:5433/roundtable
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LLM_KEY_ENCRYPTION_SECRET=
CLIENT_ORIGIN=http://localhost:5173
