# Required for local work. If unset the server assumes production — see the
# comment on NODE_ENV in apps/server/src/env.ts.
NODE_ENV=development
PORT=3001
# Required (min 32 chars) — the server refuses to boot without it, since it
# signs every login token. Generate one with: openssl rand -base64 32
JWT_SECRET=
# Local dev: run `npm run db:up` (Docker Postgres), then use this value as-is.
# Production (Render): set to Neon's *pooled* connection string (host contains "-pooler"),
# in Render's env vars only — never put Neon's URL in a local .env.
DATABASE_URL=postgresql://roundtable:roundtable@localhost:5433/roundtable
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AES-256-GCM key for encrypting each user's LLM API key at rest (docs/05 §8).
# Required in production — the server refuses to boot without it there.
# Generate one with:  openssl rand -base64 32
# Changing it makes every already-stored key undecryptable — users must re-enter theirs
# unless you keep the old value in LLM_KEY_ENCRYPTION_PREVIOUS_SECRET during rotation.
LLM_KEY_ENCRYPTION_SECRET=
# Optional. Decrypts keys written under a previous LLM_KEY_ENCRYPTION_SECRET; each
# successful read is re-encrypted with the current secret so you can drop this later.
LLM_KEY_ENCRYPTION_PREVIOUS_SECRET=

# May a user's LLM base URL point at a private or loopback address?
#
# Local models are the point of "bring your own provider" — Ollama sits on
# http://localhost:11434/v1 — so leave this on for development. In production it
# must stay off: without it, any logged-in user can aim the server at
# 169.254.169.254 or an internal service and read the reply out of the chat panel.
# Unset follows NODE_ENV (on outside production).
ASSISTANT_ALLOW_PRIVATE_LLM_HOSTS=true

# Ceiling on tokens the assistant may generate per model call. The user pays for
# these, so it bounds what one careless prompt can cost.
ASSISTANT_MAX_OUTPUT_TOKENS=2048
# Assistant turns one account may start per minute. Bounds search egress and SSE
# slots. Default 20; 0 disables the limiter.
ASSISTANT_MAX_TURNS_PER_MINUTE=20

CLIENT_ORIGIN=http://localhost:5173
