NODE_ENV=development
PORT=3001
JWT_SECRET=
# Local dev: run `npm run db:up` (Docker Postgres), then use this value as-is.
# Production (Render): set to Neon's *pooled* connection string (host contains "-pooler"),
# in Render's env vars only — never put Neon's URL in a local .env.
DATABASE_URL=postgresql://roundtable:roundtable@localhost:5433/roundtable
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AES-256-GCM key for encrypting each user's LLM API key at rest (docs/05 §8).
# Generate one with:  openssl rand -base64 32
# Changing it makes every already-stored key undecryptable — users must re-enter theirs.
LLM_KEY_ENCRYPTION_SECRET=

CLIENT_ORIGIN=http://localhost:5173

# --- DEV ONLY --------------------------------------------------------------
# Temporary stand-in for login while the Auth owner's JWT work is in flight: every request
# is treated as this user. Ignored when NODE_ENV=production. Run `npm run db:seed` and use
# the id it prints (demo-user-alice); send an `x-dev-user-id` header to act as someone else.
# Delete this line once real auth lands.
DEV_USER_ID=
