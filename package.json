{
  "name": "roundtable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev --workspace @roundtable/server\" \"npm run dev --workspace @roundtable/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "node apps/server/dist/index.js",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "prisma generate --schema apps/server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/server/prisma/schema.prisma",
    "db:seed": "tsx apps/server/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "dependencies": {
    "react-router-dom": "^7.18.2"
  }
}
